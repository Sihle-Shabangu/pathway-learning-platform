    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "prisma": "7.10.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
