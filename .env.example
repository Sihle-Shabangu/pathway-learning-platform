# Neon pooled connection string (runtime queries)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Neon direct (non-pooled) connection string (Prisma CLI and migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# Password given to every seeded user (admin and learners)
SEED_PASSWORD="replace-me"
